<Project>

  <!-- Inherits the repository's own gates, then adds what only a test project needs. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <OutputType>Exe</OutputType>

    <!-- xunit.v3's own console runner does not speak the protocol `dotnet test` uses and reports
         "zero tests ran" on a suite that passes. This switches both to Microsoft.Testing.Platform,
         so run-tests.cmd, `dotnet test` and the assembly launched directly agree. -->
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <!-- A test that never returns is ended by run-tests.cmd's timeout and named, rather than
         holding the run with nothing said. -->
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" Version="2.3.3" />
  </ItemGroup>

  <!-- The repository's root, found once rather than walked to by a copy in every class. -->
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Repository.cs" Link="Repository.cs" />
    <Using Include="PhotoBoost.Tests" />
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
