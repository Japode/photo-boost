{
  // PB38: the first cases, read through the accessibility tree.

  "fixtures": [
    {
      "name": "the window a default installation opens",
      "arguments": [],
      "shareable": true
    },
    {
      // PB23: --open reaches a photo without a dialog; the drop itself has its own case below (WW550).
      // The path is relative to winwright.json's folder, where the app is started (WW508).
      "name": "a window opened on the rotated JPEG fixture",
      "arguments": ["--open", "tests/fixtures/images/rotated-exif6.jpg", "--provider", "cpu"],
      "shareable": true
    },
    {
      // PB24: a photo open and a models folder with nothing in it, so the panel must say so.
      "name": "a window with a photo open and no models",
      "arguments": ["--open", "tests/fixtures/images/rotated-exif6.jpg", "--models", "tests/fixtures/images", "--provider", "cpu"],
      "shareable": true
    },
    {
      // PB25: a photo with transparency, so choosing JPEG has something to lose.
      "name": "a window with a transparent photo open",
      "arguments": ["--open", "tests/fixtures/images/alpha-lossless.webp", "--models", "tests/fixtures/images", "--provider", "cpu"],
      "shareable": false
    },
    {
      // PB45: a photo with camera details, exported with the default format (PNG).
      "name": "a window with a camera photo open",
      "arguments": ["--open", "tests/fixtures/images/exif-camera.jpg", "--models", "tests/fixtures/images", "--provider", "cpu"],
      "shareable": false
    },
    {
      "name": "a window asked to open a file that is not there",
      "arguments": ["--open", "tests/fixtures/images/missing.png", "--provider", "cpu"],
      "shareable": true
    },
    {
      // PB39: --provider cpu, which a case uses to be the same on every desk.
      "name": "a window forced onto the CPU",
      "arguments": ["--provider", "cpu"],
      "shareable": true
    },
    {
      // PB43: --provider winml, which asks for a provider Windows ML installed for this PC.
      "name": "a window asked for Windows ML",
      "arguments": ["--provider", "winml"],
      "shareable": true
    },
    {
      // PB57: not lent, since a drop opens a photo in it.
      "name": "an empty window to drop a photo on",
      "arguments": ["--provider", "cpu"],
      "shareable": false
    },
    {
      // PB57: a photo staged in a folder of its own, so the Save dialog writes there.
      "name": "a window on a staged photo, to save through the dialog",
      "files": ["tests/fixtures/images/rotated-exif6.jpg"],
      "arguments": ["--open", "{files}/rotated-exif6.jpg", "--provider", "cpu"],
      "shareable": false
    }
  ],

  "cases": [
    {
      "name": "a default installation puts a window named PhotoBoost on the desk",
      "catches": "an app that builds its window and then shows something else, or nothing at all, which every in-process test would pass",
      "filed": "PB38",
      "tags": ["smoke", "window"],
      "fixture": "the window a default installation opens",
      "steps": [
        {
          "locator": "TitleBar",
          "act": "read",
          "reads": "name",
          "matches": "PhotoBoost$",
          "named": "the title bar ends in the app's name"
        }
      ]
    },

    {
      // PB14: the status bar names where inference runs once detection has finished, whatever the
      // desk has: DirectML on a GPU, or CPU with or without a reason.
      "name": "the status bar says whether inference runs on the GPU or the CPU",
      "catches": "a status bar stuck on Detecting GPU, which is what a detection that hangs or throws would leave",
      "filed": "PB38",
      "tags": ["smoke", "window", "provider"],
      "fixture": "the window a default installation opens",
      "steps": [
        {
          "locator": "Text#ProviderStatus",
          "act": "read",
          "reads": "name",
          "matches": "^(DirectML · |CPU)",
          "named": "the provider chip names DirectML or CPU"
        }
      ]
    },

    {
      "name": "--provider cpu runs inference on the CPU whatever GPU the desk has",
      "catches": "a --provider flag that is parsed and then ignored, leaving detection to pick the GPU",
      "filed": "PB39",
      "tags": ["smoke", "provider", "command-line"],
      "fixture": "a window forced onto the CPU",
      "steps": [
        {
          "locator": "Text#ProviderStatus",
          "act": "read",
          "reads": "name",
          "expect": "CPU",
          "named": "the provider chip says CPU and nothing else"
        }
      ]
    },

    {
      // PB43: TensorRT-RTX on the RTX 4060 desk; a desk Windows ML has nothing for gets what auto picks.
      "name": "--provider winml names the provider it ended up on",
      "catches": "a Windows ML catalog that throws or hangs, leaving the chip on Detecting GPU",
      "filed": "PB43",
      "tags": ["smoke", "provider", "command-line"],
      "fixture": "a window asked for Windows ML",
      "steps": [
        {
          "locator": "Text#ProviderStatus",
          "act": "read",
          "reads": "name",
          "matches": "^((TensorRT-RTX|OpenVINO|DirectML) · |CPU)",
          "named": "the provider chip names a Windows ML provider, DirectML or CPU"
        }
      ]
    },

    {
      "name": "a default installation opens on the drop zone with a way to pick a file",
      "catches": "a first screen with nothing on it to open a photo with",
      "filed": "PB23",
      "tags": ["smoke", "open"],
      "fixture": "the window a default installation opens",
      "steps": [
        {
          "locator": "Button#OpenButton",
          "act": "read",
          "reads": "name",
          "expect": "Open image…",
          "named": "the open button is on the first screen"
        }
      ]
    },

    {
      "name": "a photo dropped from Explorer on the empty screen opens upright",
      "catches": "a drop zone that accepts the drag and opens nothing, or ignores the file's EXIF orientation",
      "filed": "PB57",
      "tags": ["open", "drop"],
      "fixture": "an empty window to drop a photo on",
      "steps": [
        {
          // Released over the drop zone's button: the zone itself is a Border, which has no
          // automation peer, and the window's drop handler takes a drop anywhere on it.
          "locator": "Button#OpenButton",
          "act": "drop file",
          "with": "tests/fixtures/images/rotated-exif6.jpg",
          "named": "the photo is dropped on the drop zone"
        },
        {
          "locator": "Text#ImageInfo",
          "act": "read",
          "reads": "name",
          "expect": "rotated-exif6.jpg — 8 × 16",
          "named": "it opens, named and upright"
        }
      ]
    },

    {
      // PB13: only the offer is read; the download itself needs the network, which a case does not
      // reach, and ModelDownloadsTests drives it against a stand-in server.
      "name": "with no models About offers the high-quality download",
      "catches": "an About panel that hides the optional FP32 download, or offers it disabled",
      "filed": "PB13",
      "tags": ["about", "download"],
      "fixture": "a window with a photo open and no models",
      "steps": [
        {
          "locator": "Button#AboutButton",
          "act": "invoke",
          "named": "About is opened"
        },
        {
          "locator": "Text#DownloadNote",
          "act": "read",
          "reads": "name",
          "matches": "^The high-quality \\(FP32\\) models are an optional download of up to 690 MB",
          "named": "it says what the download is and how large"
        },
        {
          "locator": "Button#DownloadModelsButton",
          "act": "read",
          "reads": "enabled",
          "expect": "enabled",
          "named": "and offers it"
        },
        {
          "locator": "Button#AboutClose",
          "act": "invoke",
          "named": "About is closed"
        }
      ]
    },

    {
      // PB57: choose file types the name and reads it back before confirming (winwright WW561).
      "name": "Save as writes the photo where the Save dialog is told",
      "catches": "a Save as whose dialog closes and writes nothing, or writes under another name",
      "filed": "PB57",
      "tags": ["export", "dialog"],
      "fixture": "a window on a staged photo, to save through the dialog",
      "steps": [
        {
          "locator": "Button#SaveButton",
          "act": "invoke",
          "named": "Save as is pressed"
        },
        {
          "locator": "Window[class=\"#32770\"]",
          "act": "choose file",
          "with": "{files}/saved.png",
          "named": "the dialog is told to save saved.png in the staged folder"
        },
        {
          "locator": "Window[class=\"#32770\"]",
          "act": "read",
          "absent": true,
          "named": "the dialog closed"
        },
        {
          "locator": "Text#ExportStatus",
          "act": "read",
          "reads": "name",
          "expect": "Saved saved.png",
          "named": "the export card says it saved saved.png"
        }
      ]
    },

    {
      "name": "--open shows the photo upright with its name and size",
      "catches": "an open that ignores EXIF orientation, shows nothing, or reports the wrong size",
      "filed": "PB23",
      "tags": ["open"],
      "fixture": "a window opened on the rotated JPEG fixture",
      "steps": [
        {
          "locator": "Text#ImageInfo",
          "act": "read",
          "reads": "name",
          "expect": "rotated-exif6.jpg — 8 × 16",
          "named": "the caption names the file and its upright size"
        },
        {
          // PB27: the photo is in the GPU surface, which publishes its state as item status.
          "locator": "Slider#Surface",
          "act": "read",
          "reads": "status",
          "matches": "^zoom 1x, Single",
          "named": "the photo is on the surface, fitted, not compared"
        },
        {
          // PB27: comparing needs a result, so here it is off; the tiny-model case (PB42) turns it on.
          "locator": "RadioButton#ModeDivider",
          "act": "read",
          "reads": "enabled",
          "expect": "not enabled",
          "named": "and there is nothing to compare it with yet"
        }
      ]
    },

    {
      // The run itself is cases/upscale.cases.json's, on PB42's tiny models.
      "name": "with no models the operations panel says which one is missing",
      "catches": "an Upscale button that starts a run doomed to fail, or a panel that hides why it cannot run",
      "filed": "PB24",
      "tags": ["operations"],
      "fixture": "a window with a photo open and no models",
      "steps": [
        {
          "locator": "Text#OperationNote",
          "act": "read",
          "reads": "name",
          "matches": "^realesrgan-x4plus \\(fp16\\) is not in .*Download the models first\\.$",
          "named": "the note names the 4x model and its variant"
        },
        {
          "locator": "Button#UpscaleButton",
          "act": "read",
          "reads": "enabled",
          "expect": "not enabled",
          "named": "and the upscale button cannot start a run"
        }
      ]
    },

    {
      // PB36: SCUNet is real-model only; a run was driven by hand on building.png.
      "name": "with no models the Denoise card says which one is missing",
      "catches": "a Denoise button that starts a run doomed to fail",
      "filed": "PB36",
      "tags": ["operations", "denoise"],
      "fixture": "a window with a photo open and no models",
      "steps": [
        {
          "locator": "Text#DenoiseNote",
          "act": "read",
          "reads": "name",
          "matches": "^scunet-color-real-psnr \\(fp16\\) is not in .*Download the models first\\.$",
          "named": "the note names SCUNet and its variant"
        },
        {
          "locator": "Button#DenoiseButton",
          "act": "read",
          "reads": "enabled",
          "expect": "not enabled",
          "named": "and the button cannot start a run"
        }
      ]
    },

    {
      // PB31: the detector and GFPGAN are real models only (no stand-in finds a face), so a run
      // was driven by hand: Blake_Lively.jpg, both faces restored on DirectML in 3.1 s.
      "name": "with no models the Restore faces card says which one is missing and shows GFPGAN's terms",
      "catches": "a Restore faces button that starts a run doomed to fail, or GFPGAN's non-commercial terms dropped from the card",
      "filed": "PB31",
      "tags": ["operations", "faces"],
      "fixture": "a window with a photo open and no models",
      "steps": [
        {
          "locator": "Text#FaceNote",
          "act": "read",
          "reads": "name",
          "matches": "^yunet-2023mar \\(fp32\\) is not in .*Download the models first\\.$",
          "named": "the note names the face detector first"
        },
        {
          "locator": "Button#RestoreFacesButton",
          "act": "read",
          "reads": "enabled",
          "expect": "not enabled",
          "named": "and the button cannot start a run"
        },
        {
          "locator": "Text#FaceLicence",
          "act": "read",
          "reads": "name",
          "matches": "non-commercial licences: research or evaluation use only\\.$",
          "named": "the card states GFPGAN's terms"
        },
        {
          "locator": "Slider#FaceStrength",
          "act": "read",
          "reads": "range",
          "expect": "100",
          "named": "strength starts at full"
        }
      ]
    },

    {
      // PB32: RMBG-1.4 is real-model only; a run was driven by hand (example_input.jpg, both
      // giraffes cut out, exported as a 933 x 1405 RGBA PNG on DirectML).
      "name": "with no models the Remove background card says so and shows RMBG-1.4's terms",
      "catches": "a Remove background button that starts a run doomed to fail, or BRIA's non-commercial terms dropped from the card",
      "filed": "PB32",
      "tags": ["operations", "background"],
      "fixture": "a window with a photo open and no models",
      "steps": [
        {
          "locator": "Text#BackgroundNote",
          "act": "read",
          "reads": "name",
          "matches": "^rmbg-1\\.4 \\(fp16\\) is not in .*Download the models first\\.$",
          "named": "the note names RMBG-1.4 and its variant"
        },
        {
          "locator": "Button#RemoveBackgroundButton",
          "act": "read",
          "reads": "enabled",
          "expect": "not enabled",
          "named": "and the button cannot start a run"
        },
        {
          "locator": "Text#BackgroundLicence",
          "act": "read",
          "reads": "name",
          "matches": "^RMBG-1\\.4 is licensed by BRIA for non-commercial use",
          "named": "the card states BRIA's terms"
        }
      ]
    },

    {
      "name": "choosing JPEG for a transparent photo warns and offers a background",
      "catches": "a JPEG export that silently turns transparent pixels black",
      "filed": "PB25",
      "tags": ["export"],
      "fixture": "a window with a transparent photo open",
      "steps": [
        {
          "locator": "ComboBox#ExportFormat",
          "act": "expand",
          "named": "the format list is opened"
        },
        {
          "locator": "ComboBox#ExportFormat > ListItem[name=\"JPEG\"]",
          "act": "select",
          "reads": "selected",
          "expect": "selected",
          "named": "JPEG is chosen"
        },
        {
          "locator": "Text#TransparencyWarning",
          "act": "read",
          "reads": "name",
          "matches": "^JPEG has no transparency",
          "named": "the warning says what happens to transparent pixels"
        },
        {
          "locator": "ComboBox#ExportBackground",
          "act": "read",
          "reads": "name",
          "expect": "Background",
          "named": "and a background can be chosen"
        }
      ]
    },

    {
      // Chaining, undo and redo with real models were driven by hand on the PB28 desk:
      // 179 -> 358 -> 716 px, undo to 358, redo to 716, three entries listed.
      "name": "an opened photo starts a history with nothing to undo",
      "catches": "a history that does not start from the opened file, or an undo that is offered with nothing behind it",
      "filed": "PB28",
      "tags": ["history"],
      "fixture": "a window opened on the rotated JPEG fixture",
      "steps": [
        {
          "locator": "List#History > ListItem[order=top]",
          "act": "read",
          "reads": "name",
          "expect": "1. Opened rotated-exif6.jpg",
          "named": "the first entry is the opened file"
        },
        {
          "locator": "Button#UndoButton",
          "act": "read",
          "reads": "enabled",
          "expect": "not enabled",
          "named": "and undo has nothing to go back to"
        }
      ]
    },

    {
      "name": "keeping camera details for a PNG says only JPEG keeps them",
      "catches": "a Keep camera details box that silently does nothing for the chosen format",
      "filed": "PB45",
      "tags": ["export"],
      "fixture": "a window with a camera photo open",
      "steps": [
        {
          "locator": "CheckBox#KeepMetadata",
          "act": "read",
          "reads": "toggle",
          "expect": "Off",
          "named": "camera details are not kept unless asked"
        },
        {
          "locator": "CheckBox#KeepMetadata",
          "act": "toggle",
          "reads": "toggle",
          "expect": "On",
          "named": "asking to keep them"
        },
        {
          "locator": "Text#MetadataNote",
          "act": "read",
          "reads": "name",
          "matches": "^Only JPEG keeps camera details",
          "named": "the card says PNG will not carry them"
        }
      ]
    },

    {
      "name": "--open on a missing file says so on the drop zone",
      "catches": "an open that fails silently or crashes the app on a bad path",
      "filed": "PB23",
      "tags": ["open"],
      "fixture": "a window asked to open a file that is not there",
      "steps": [
        {
          "locator": "Text#OpenError",
          "act": "read",
          "reads": "name",
          "expect": "missing.png was not found.",
          "named": "the drop zone names the missing file"
        }
      ]
    }
  ]
}
