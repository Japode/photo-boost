{
  // PB26: the open, upscale and export flow end to end, on the tiny stand-in models (PB42: a
  // nearest-neighbour 4x and 2x, cases/fixtures/models), so a whole run happens offline on the
  // CPU and its export is byte-for-byte checkable. The real models on DirectML are run by hand.

  "fixtures": [
    {
      // Not lent: it runs and writes. Its arguments name the staged folder through {files} (WW556).
      "name": "a window on the tiny models, exporting into its own folder",
      "files": [
        "tests/fixtures/images/rotated-exif6.jpg",
        { "from": "cases/fixtures/models/realesrgan-x4plus/fp32.onnx", "to": "models/realesrgan-x4plus/fp32.onnx" },
        { "from": "cases/fixtures/models/realesrgan-x4plus/fp16.onnx", "to": "models/realesrgan-x4plus/fp16.onnx" },
        { "from": "cases/fixtures/models/realesrgan-x4plus/meta.json", "to": "models/realesrgan-x4plus/meta.json" },
        { "from": "cases/fixtures/models/realesrgan-x2plus/fp32.onnx", "to": "models/realesrgan-x2plus/fp32.onnx" },
        { "from": "cases/fixtures/models/realesrgan-x2plus/fp16.onnx", "to": "models/realesrgan-x2plus/fp16.onnx" },
        { "from": "cases/fixtures/models/realesrgan-x2plus/meta.json", "to": "models/realesrgan-x2plus/meta.json" }
      ],
      "arguments": ["--open", "{files}/rotated-exif6.jpg", "--models", "{files}/models", "--provider", "cpu", "--export", "{files}/out.png"],
      "shareable": false
    }
  ],

  "cases": [
    {
      "name": "an opened photo is upscaled and exported end to end",
      "catches": "any break between opening a photo, running Real-ESRGAN 4x through the tiles and writing the result to disk",
      "filed": "PB26",
      "tags": ["operations", "export"],
      "fixture": "a window on the tiny models, exporting into its own folder",
      "steps": [
        {
          "locator": "Text#ImageInfo",
          "act": "read",
          "reads": "name",
          "expect": "rotated-exif6.jpg — 8 × 16",
          "named": "the photo is open, upright"
        },
        {
          // The models are listed after the window shows, so the button is enabled a moment later.
          "locator": "Button#UpscaleButton",
          "act": "read",
          "reads": "enabled",
          "expect": "enabled",
          "named": "the models are loaded"
        },
        {
          "locator": "Button#UpscaleButton",
          "act": "invoke",
          "named": "Upscale 4x is started"
        },
        {
          "locator": "Text#JobStatus",
          "act": "read",
          "reads": "name",
          "expect": "Done: 32 × 64.",
          "named": "the run finishes"
        },
        {
          // PB60: the card above the operations names the run, so it is seen without scrolling.
          "locator": "Text#JobTitle",
          "act": "read",
          "reads": "name",
          "expect": "Upscale 4×",
          "named": "the pinned card names the run"
        },
        {
          // Cancel and the status bar's chip are only for a run in progress.
          "locator": "Button#CancelButton",
          "act": "read",
          "absent": true,
          "named": "and offers no cancel once it is done"
        },
        {
          // An 8 x 16 photo is one tile, so the bar ends at one of one.
          "locator": "ProgressBar#JobProgress",
          "act": "read",
          "reads": "range",
          "expect": "1",
          "named": "with the progress bar at its last tile"
        },
        {
          "locator": "Text#LastRun",
          "act": "read",
          "reads": "name",
          // The operation log's own words (PB22); the seconds are in the desk's culture.
          "matches": "^upscale x4: [0-9.,]+ s on Cpu$",
          "named": "and the run's time and provider on the status bar"
        },
        {
          "locator": "Text#ImageInfo",
          "act": "read",
          "reads": "name",
          "expect": "rotated-exif6.jpg — Upscale 4× — 32 × 64",
          "named": "the result is four times the upright photo"
        },
        {
          "locator": "Text#ExportStatus",
          "act": "read",
          "reads": "name",
          "expect": "Saved out.png",
          "named": "--export wrote the result"
        },
        {
          "file": "{files}/out.png",
          "act": "read",
          "sameBytesAs": "cases/fixtures/expected/rotated-exif6-x4.png",
          "named": "with exactly the expected bytes"
        }
      ]
    },

    {
      "name": "About lists each model with the license its meta.json carries",
      "catches": "a model's license missing from the app, or the About panel failing to open or close",
      "filed": "PB46",
      "tags": ["about"],
      "fixture": "a window on the tiny models, exporting into its own folder",
      "steps": [
        {
          "locator": "Button#AboutButton",
          "act": "invoke",
          "named": "About is opened"
        },
        {
          "locator": "Text#AboutVersion",
          "act": "read",
          "reads": "name",
          "matches": "^Version \\d+\\.\\d+\\.\\d+",
          "named": "it says the version"
        },
        {
          "locator": "List#AboutModels > ListItem[order=top]",
          "act": "read",
          "reads": "name",
          "matches": "^realesrgan-x2plus · upscale · fp16, fp32 · test fixture, no weights \\(https://",
          "named": "the first model, its variants and its license"
        },
        {
          // PB58: the tiny upscalers are here, but GFPGAN, RMBG and ViTMatte download on first use.
          "locator": "Text#DownloadNote",
          "act": "read",
          "reads": "name",
          "matches": "^Restore faces and Remove background download their models the first time you use them\\. To work offline from the start, download everything now: ",
          "named": "About says which operations download on first use"
        },
        {
          "locator": "Button#DownloadModelsButton",
          "act": "read",
          "reads": "enabled",
          "expect": "enabled",
          "named": "and offers everything at once"
        },
        {
          "locator": "Button#AboutClose",
          "act": "invoke",
          "named": "About is closed"
        },
        {
          "locator": "Button#AboutButton",
          "act": "read",
          "reads": "name",
          "expect": "About",
          "named": "and the photo is back"
        }
      ]
    },

    {
      "name": "with the FP32 set on disk High quality can be chosen and the upscale stays available",
      "catches": "a quality choice that stays disabled once the FP32 models are there, or one that loses the upscale's models",
      "filed": "PB29",
      "tags": ["operations", "quality"],
      "fixture": "a window on the tiny models, exporting into its own folder",
      "steps": [
        {
          "locator": "RadioButton#QualityHigh",
          "act": "read",
          "reads": "enabled",
          "expect": "enabled",
          "named": "High quality is offered"
        },
        {
          "locator": "RadioButton#QualityHigh",
          "act": "select",
          "reads": "selected",
          "expect": "selected",
          "named": "High quality is chosen"
        },
        {
          "locator": "Text#QualityNote",
          "act": "read",
          "reads": "name",
          "matches": "^High quality uses the FP32 models",
          "named": "the note says what it runs"
        },
        {
          "locator": "Button#UpscaleButton",
          "act": "read",
          "reads": "enabled",
          "expect": "enabled",
          "named": "and the 4x upscale still has its model, now FP32"
        }
      ]
    },

    {
      "name": "an upscaled result is compared and undone",
      "catches": "a break in Compare's divider or in undo and redo once a real result exists, which PB27 and PB28 checked by hand",
      "filed": "PB42",
      "tags": ["history", "compare"],
      "fixture": "a window on the tiny models, exporting into its own folder",
      "steps": [
        {
          // The models are listed after the window shows, so the button is enabled a moment later.
          "locator": "Button#UpscaleButton",
          "act": "read",
          "reads": "enabled",
          "expect": "enabled",
          "named": "the models are loaded"
        },
        {
          "locator": "Button#UpscaleButton",
          "act": "invoke",
          "named": "Upscale 4x is started"
        },
        {
          "locator": "Text#JobStatus",
          "act": "read",
          "reads": "name",
          "expect": "Done: 32 × 64.",
          "named": "the run finishes"
        },
        {
          "locator": "Text#LastRun",
          "act": "read",
          "reads": "name",
          "matches": "^upscale x4: ",
          "named": "and the status bar times it"
        },
        {
          "locator": "RadioButton#ModeDivider",
          "act": "select",
          "reads": "selected",
          "expect": "selected",
          "named": "the comparison is turned on"
        },
        {
          "locator": "Slider#Surface",
          "act": "set range",
          "with": "25",
          "reads": "range",
          "expect": "25",
          "named": "the divider is moved to a quarter"
        },
        {
          "locator": "Slider#Surface",
          "act": "read",
          "reads": "status",
          "matches": "^zoom 1x, Divider",
          "named": "and the surface shows the divider"
        },
        {
          "locator": "Button#UndoButton",
          "act": "invoke",
          "named": "the upscale is undone"
        },
        {
          "locator": "Text#ImageInfo",
          "act": "read",
          "reads": "name",
          "expect": "rotated-exif6.jpg — 8 × 16",
          "named": "the opened photo is back"
        },
        {
          // PB61: the run's outcome describes a version no longer shown, so it goes from both places.
          "locator": "Text#JobStatus",
          "act": "read",
          "absent": true,
          "named": "the run's card no longer says Done"
        },
        {
          "locator": "Text#LastRun",
          "act": "read",
          "absent": true,
          "named": "nor the status bar its time"
        },
        {
          "locator": "Button#RedoButton",
          "act": "invoke",
          "named": "and redone"
        },
        {
          "locator": "Text#ImageInfo",
          "act": "read",
          "reads": "name",
          "expect": "rotated-exif6.jpg — Upscale 4× — 32 × 64",
          "named": "the result is back without running again"
        }
      ]
    }
  ]
}
