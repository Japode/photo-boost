{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://photoboost.local/meta.schema.json",
  "title": "PhotoBoost model meta.json",
  "description": "PB11: what export-and-quantize.py writes beside each model's ONNX variants and PhotoBoost.Inference's ModelMeta reads. Bump schema when a field changes meaning.",
  "type": "object",
  "required": ["schema", "name", "task", "scale", "input", "output", "tile", "variants", "upstream"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "name": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
    "task": { "enum": ["upscale", "face-restore", "background-removal"] },
    "scale": { "type": "integer", "minimum": 1 },
    "input": {
      "type": "object",
      "required": ["name", "layout", "colour_order", "channels", "value_range", "size", "multiple", "batch"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "layout": { "const": "NCHW" },
        "colour_order": { "const": "RGB" },
        "channels": { "const": 3 },
        "value_range": { "$ref": "#/$defs/range" },
        "size": { "description": "A fixed square side, or null when height and width are dynamic.", "type": ["integer", "null"], "minimum": 1 },
        "multiple": { "description": "Height and width must be a multiple of this.", "type": "integer", "minimum": 1 },
        "batch": { "oneOf": [{ "const": "dynamic" }, { "type": "integer", "minimum": 1 }] }
      }
    },
    "output": {
      "type": "object",
      "required": ["name", "channels", "value_range"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "channels": { "enum": [1, 3] },
        "value_range": { "$ref": "#/$defs/range" }
      }
    },
    "tile": {
      "type": "object",
      "required": ["recommended", "largest_activation_bytes_per_pixel"],
      "additionalProperties": false,
      "properties": {
        "recommended": { "description": "Tile side to start from, or null for a fixed-size model.", "type": ["integer", "null"], "minimum": 1 },
        "largest_activation_bytes_per_pixel": { "description": "The biggest FP32 tensor any layer produces, per input pixel; not the peak.", "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "variants": {
      "type": "object",
      "required": ["fp32"],
      "additionalProperties": false,
      "properties": {
        "fp32": { "$ref": "#/$defs/variant" },
        "fp16": { "$ref": "#/$defs/variant" },
        "int8": { "$ref": "#/$defs/variant" }
      }
    },
    "upstream": {
      "type": "object",
      "required": ["url", "license", "license_url"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "pattern": "^https://" },
        "license": { "type": "string", "minLength": 1 },
        "license_url": { "type": "string", "pattern": "^https://" }
      }
    },
    "validation": {
      "type": "object",
      "required": ["image", "input", "against"],
      "properties": {
        "image": { "type": "string" },
        "input": { "type": "array", "items": { "type": "integer" }, "minItems": 4, "maxItems": 4 },
        "against": { "const": "fp32" },
        "fp16": { "$ref": "#/$defs/quality" },
        "int8": { "$ref": "#/$defs/quality" }
      }
    }
  },
  "$defs": {
    "range": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
    "variant": {
      "type": "object",
      "required": ["file", "bytes", "sha256"],
      "additionalProperties": false,
      "properties": {
        "file": { "type": "string", "pattern": "^(fp32|fp16|int8)\\.onnx$" },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "quality": {
      "type": "object",
      "required": ["psnr_db", "ssim"],
      "properties": {
        "psnr_db": { "type": "number" },
        "ssim": { "type": "number" },
        "min_psnr_db": { "type": "number" }
      }
    }
  }
}
