<Project Sdk="Microsoft.NET.Sdk">

  <!-- ONNX Runtime: provider detection, sessions loaded on demand and the one-at-a-time queue.
       It reads tensors from Imaging and never sees a UI type. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>PhotoBoost.Inference</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- The PB5 spike's choice (spike/onnx-runtime/README.md): any DX12 GPU, exact against CPU,
         nothing fetched from Windows Update. -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.4" />
    <!-- Only to list adapters and their video memory; rendering stays in PhotoBoost.Render. -->
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PhotoBoost.Imaging\PhotoBoost.Imaging.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tests write ProbeModel to disk to load a real session without a downloaded model. -->
    <InternalsVisibleTo Include="PhotoBoost.Inference.Tests" />
  </ItemGroup>

</Project>
